encryption-device-label = IRCord GPUI on { $os }
encryption-open-settings = Open settings
encryption-banner-fresh = { $name } started fresh with new encryption keys. Earlier messages stay readable here, but { $name }'s new devices cannot read them. This is expected if { $name } lost their devices. It would look the same if someone else had got into { $name }'s account or the server were interfering, so if in doubt, check with { $name } another way.
encryption-banner-verify = Verify { $name }
encryption-banner-ok = OK
encryption-banner-unencrypted = A message arrived in this encrypted chat without encryption. It is marked in red; the chat stays encrypted.
encryption-banner-not-ready = This chat is encrypted. Approve this device to read and send in it.
encryption-panel-title = End-to-end encryption
encryption-panel-none = Open a direct conversation to see its encryption.
