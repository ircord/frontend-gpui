encryption-banner-verify = Verify { $name }
encryption-banner-ok = OK
encryption-banner-unencrypted = A message arrived in this encrypted chat without encryption. It is marked in red; the chat stays encrypted.
encryption-banner-not-ready = This chat is encrypted. Approve this device to read and send in it.
encryption-panel-title = End-to-end encryption
encryption-panel-none = Open a direct conversation to see its encryption.
