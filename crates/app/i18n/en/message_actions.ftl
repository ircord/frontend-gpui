# Text for package A1. IDs start with `message-actions-`.

# Menu and toolbar
message-actions-reply = Reply
message-actions-react = Add reaction
message-actions-react-with = React with { $emoji }
message-actions-edit = Edit
message-actions-copy-text = Copy text
message-actions-copy-link = Copy link to message
message-actions-versions = Show earlier versions
message-actions-delete = Delete message

# Reaction chips
message-actions-reaction-chip = { $emoji } { $count }
message-actions-reaction-label = { $emoji }: { $count }. Click to add or remove yours.
message-actions-reactions = Reactions

# Quick reactions
message-actions-react-title = Add a reaction

# The bar above the box
message-actions-replying = Replying to { $nick }
message-actions-editing = Editing your message
message-actions-cancel = Cancel
message-actions-escape-hint = Escape to cancel

# A failed send in the timeline
message-actions-retry = Retry
message-actions-to-draft = Move to draft
message-actions-copy-send = Copy text
message-actions-send-copied = Message text copied.
message-actions-remove-send = Remove from outbox
message-actions-remove-send-title = Remove this message from the outbox?
message-actions-remove-send-body = This removes your saved send. Copy the text first if you want to keep it.

# Deleting
message-actions-delete-title = Delete message?
message-actions-delete-body = This deletes the message for everyone in the conversation.
message-actions-delete-attachment-body = This deletes the message for everyone. The uploaded file is kept.
message-actions-delete-confirm = Delete

# Copying
message-actions-copied = Copied to the clipboard.
message-actions-link-copied = Link copied.

# Earlier versions
message-actions-versions-title = Earlier versions
message-actions-original-at = Original, { $time }
message-actions-edited-at = Edited { $time }

# Why an action is unavailable
message-actions-reason-reconnect = Reconnect to this network to use this action.
message-actions-reason-join = Join this channel to use this action.
message-actions-reason-send-reconnect = Reconnect to this network to send messages.
message-actions-reason-send-join = Join this channel to send messages.
message-actions-reason-moderated = This channel is moderated. You need voice or operator privileges to send messages.
message-actions-reason-invalid-id = This message has no usable network message ID.
message-actions-reason-delete-own = You can only delete your own messages.
message-actions-reason-edit-own = You can only edit your own messages.
message-actions-reason-edit-notice = Notices cannot be edited.
message-actions-reason-edit-media = GIFs and uploads cannot be edited.
message-actions-reason-replies = Replies are unavailable on this network.
message-actions-reason-reactions = Reactions are unavailable on this network.
message-actions-reason-delete-unsupported = This network does not support deleting messages.
message-actions-reason-edit-unsupported = This network does not support editing messages (it needs message-tags, echo-message and account-tag).
message-actions-reason-edit-account = Editing needs a logged-in account on this network.
message-actions-reason-edit-other-account = This message was not sent from the account you are logged into, so other clients would not accept the edit.
message-actions-reason-delete-account = Deleting needs a logged-in account on this network.
message-actions-reason-delete-other-account = This message was not sent from the account you are logged into, so the network will not delete it.
message-actions-reason-text-length = Use at most { $characters } characters and { $bytes } UTF-8 bytes per message.
message-actions-reason-text-line-limit = This network has not supplied a usable message line limit.
message-actions-reason-text-multiline-unsupported = This network does not support multiline messages. Use one line of at most { $bytes } UTF-8 bytes.
message-actions-reason-text-multiline-bytes = This network allows at most { $bytes } UTF-8 bytes per multiline message.
message-actions-reason-text-multiline-lines = This network allows at most { $lines } wire lines per multiline message.
message-actions-reason-party-provisioning = Setting up this conversation…
message-actions-reason-party-recovering = Reconnecting this conversation…
message-actions-reason-party-archived = This conversation is archived.
message-actions-reason-party-inactive = This conversation is no longer active.
