channel-settings-scope-extended = A server-specific extended mask, sent as typed.
channel-settings-scope-extended-negated = A server-specific extended mask (negated: it matches everyone the rest doesn’t), sent as typed.
channel-settings-scope-matches = Matches { $parts }.
channel-settings-scope-matches-forward = Matches { $parts } and sends them to { $channel } instead.
channel-settings-part-nick = the nick { $value }
channel-settings-part-nick-pattern = a nick matching { $value }
channel-settings-part-user = the username { $value }
channel-settings-part-user-pattern = a username matching { $value }
channel-settings-part-host = the host { $value }
channel-settings-part-host-pattern = a host matching { $value }
channel-settings-part-anyone-with = anyone with { $parts }
channel-settings-part-everyone = everyone
channel-settings-part-join-two = { $first } and { $second }
channel-settings-part-join-many = { $first }, and { $last }
channel-settings-broad-everyone = This matches everyone, including you.
channel-settings-broad-host = The host part is very broad: it can match a whole country, provider or address range.
channel-settings-broad-nick = The nick part is very broad: it matches every nick with those few letters.

