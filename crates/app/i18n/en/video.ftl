# Text for package M5: the video player. IDs start with `video-`.
video-play = Play { $name }
video-play-again = Play again
video-cannot-play = This video cannot play here
video-enlarge = Enlarge
video-exit-fullscreen = Exit fullscreen
video-open-in-browser = Open in the browser
video-viewer-title = Video

# The banner when the system's GStreamer cannot play video (Linux)
video-gstreamer-label = Video needs GStreamer
video-gstreamer-absent = Videos play through your system's GStreamer, which is not installed. Until it is, videos open in the browser.
video-gstreamer-missing = Videos play through your system's GStreamer, which lacks { $parts }. Until it has them, videos open in the browser.
video-gstreamer-part-gstreamer = GStreamer itself
video-gstreamer-part-base = the base plugins
video-gstreamer-part-good = the good plugins
video-gstreamer-part-libav = the libav plugin
video-gstreamer-install = Install with:
video-gstreamer-install-other = Install GStreamer 1.x with its base, good and libav plugins from your distribution's packages.
video-gstreamer-copy = Copy command
video-gstreamer-copied = Copied
video-gstreamer-check = Check again
video-gstreamer-checking = Checking…
video-gstreamer-dismiss = Not now
