[
  {"name": "masked https link", "text": "see [the docs](https://example.com/docs) now", "visible": "see the docs now", "links": [["the docs", "https://example.com/docs"]]},
  {"name": "masked http link", "text": "[site](http://example.com)", "visible": "site", "links": [["site", "http://example.com"]]},
  {"name": "masked mailto link", "text": "[mail us](mailto:team@example.com)", "visible": "mail us", "links": [["mail us", "mailto:team@example.com"]]},
  {"name": "two masked links", "text": "[a](https://a.example) and [b](https://b.example)", "visible": "a and b", "links": [["a", "https://a.example"], ["b", "https://b.example"]]},
  {"name": "relative address is not masked", "text": "[x](/path)", "visible": "[x](/path)", "links": []},
  {"name": "javascript address is not masked", "text": "[x](javascript:alert(1))", "visible": "[x](javascript:alert(1))", "links": []},
  {"name": "ftp address is not masked", "text": "[f](ftp://example.com/a)", "visible": "[f](ftp://example.com/a)", "links": []},
  {"name": "irc address is not masked, stays an ordinary link", "text": "[chat](irc://irc.libera.chat/#rust)", "visible": "[chat](irc://irc.libera.chat/#rust)", "links": [["irc://irc.libera.chat/#rust", "irc://irc.libera.chat/#rust"]]},
  {"name": "text naming the same host is masked", "text": "[https://example.com/a](https://example.com/b)", "visible": "https://example.com/a", "links": [["https://example.com/a", "https://example.com/b"]]},
  {"name": "text naming another url is not masked", "text": "[https://good.example](https://evil.example/login)", "visible": "[https://good.example](https://evil.example/login)", "links": [["https://evil.example/login", "https://evil.example/login"]]},
  {"name": "bare domain naming another host is not masked", "text": "[paypal.com](https://evil.example)", "visible": "[paypal.com](https://evil.example)", "links": [["https://evil.example", "https://evil.example"]]},
  {"name": "bare domain naming the same host is masked", "text": "[example.com](https://example.com/x)", "visible": "example.com", "links": [["example.com", "https://example.com/x"]]},
  {"name": "www is another host", "text": "[example.com](https://www.example.com)", "visible": "[example.com](https://www.example.com)", "links": [["https://www.example.com", "https://www.example.com"]]},
  {"name": "a domain among other words is not masked", "text": "[log in to bank.example now](https://evil.example)", "visible": "[log in to bank.example now](https://evil.example)", "links": [["https://evil.example", "https://evil.example"]]},
  {"name": "an email address naming another domain is not masked", "text": "[bob@good.example](mailto:bob@evil.example)", "visible": "[bob@good.example](mailto:bob@evil.example)", "links": [["mailto:bob@evil.example", "mailto:bob@evil.example"]]},
  {"name": "a look-alike host is another host", "text": "[paypal.com](https://p\u0430ypal.com)", "visible": "[paypal.com](https://p\u0430ypal.com)", "links": [["https://p\u0430ypal.com", "https://p\u0430ypal.com"]]},
  {"name": "a version number is not a domain", "text": "[v1.2.3 notes](https://example.com/notes)", "visible": "v1.2.3 notes", "links": [["v1.2.3 notes", "https://example.com/notes"]]},
  {"name": "formatting inside the text is kept", "text": "[\u0002bold\u0002 text](https://example.com)", "visible": "bold text", "links": [["bold text", "https://example.com"]]},
  {"name": "nested brackets", "text": "[a [b] c](https://example.com)", "visible": "a [b] c", "links": [["a [b] c", "https://example.com"]]},
  {"name": "an escaped closing bracket", "text": "[a \\] b](https://example.com)", "visible": "a ] b", "links": [["a ] b", "https://example.com"]]},
  {"name": "an escaped opening bracket makes no link", "text": "\\[a](https://example.com)", "visible": "\\[a](https://example.com)", "links": [["https://example.com", "https://example.com"]]},
  {"name": "an address with parentheses", "text": "[Rust](https://en.wikipedia.org/wiki/Rust_(programming_language)).", "visible": "Rust.", "links": [["Rust", "https://en.wikipedia.org/wiki/Rust_(programming_language)"]]},
  {"name": "a space before the address makes no link", "text": "[text] (https://example.com)", "visible": "[text] (https://example.com)", "links": [["https://example.com", "https://example.com"]]},
  {"name": "inside a code span stays as typed", "text": "\u0011[a](https://example.com)\u0011", "visible": "[a](https://example.com)", "links": []},
  {"name": "empty text makes no link", "text": "[ ](https://example.com)", "visible": "[ ](https://example.com)", "links": [["https://example.com", "https://example.com"]]},
  {"name": "a space in the address makes no link", "text": "[a](https://example.com/a b)", "visible": "[a](https://example.com/a b)", "links": [["https://example.com/a", "https://example.com/a"]]},
  {"name": "an unclosed address makes no link", "text": "[a](https://example.com", "visible": "[a](https://example.com", "links": [["https://example.com", "https://example.com"]]},
  {"name": "a link inside an unclosed bracket", "text": "[see [x](https://example.com)", "visible": "[see x", "links": [["x", "https://example.com"]]},
  {"name": "the text does not span lines", "text": "[a\nb](https://example.com)", "visible": "[a\nb](https://example.com)", "links": [["https://example.com", "https://example.com"]]}
]
